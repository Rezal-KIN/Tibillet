# ============================================================
# Laboutik — Configuration de l'instance principale
# Copier ce fichier en .env et remplir toutes les valeurs
# ============================================================

# --- Sécurité ---
# Générer avec : python -c "import secrets; print(secrets.token_hex(25))"
DJANGO_SECRET=your-50-char-secret-key-here
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# --- Base de données PostgreSQL ---
POSTGRES_USER=laboutik_user
POSTGRES_DB=laboutik
POSTGRES_PASSWORD=your-db-password

# --- Domaine ---
# Ex : cashless.monassociation.fr
DOMAIN=cashless.example.fr

# --- Email admin ---
ADMIN_EMAIL=admin@example.fr

# --- Email transactionnel (ex : Brevo/Sendgrid) ---
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=contact@example.fr
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# --- Localisation ---
TIME_ZONE=Europe/Paris
LANGUAGE_CODE='fr'
TZ=Europe/Paris

# --- Connexion aux autres services TiBillet ---
# URL de votre instance Fedow
FEDOW_URL=https://fedow.example.fr
# URL racine de votre instance Lespass (sans sous-domaine tenant)
LESPASS_TENANT_URL=https://example.fr/

# --- Cashless ---
# Nom de l'unité monétaire (ex : FestivalCoin, KinCoin)
MAIN_ASSET_NAME=MyCoin

# --- Happy Hour (prix réduits automatiques sur plage horaire) ---
HAPPY_HOUR_START=22:00
HAPPY_HOUR_END=23:30
# Chemin du fichier JSON de prix Happy Hour dans le container
HAPPY_HOUR_PRICE_FILE=/DjangoFiles/www/happy_hour_prices.json

# --- Sauvegarde BorgBackup (laisser vide si non utilisé) ---
BORG_REPO=''
BORG_PASSPHRASE=''

# --- Version épinglée de l'image Docker ---
# Voir les versions disponibles : https://hub.docker.com/r/tibillet/laboutik/tags
LABOUTIK_VERSION=1.3.8
