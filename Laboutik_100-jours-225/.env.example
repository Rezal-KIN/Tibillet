# ============================================================
# Laboutik — Instance additionnelle (ex : caisse par gala/événement)
# Copier ce fichier en .env et remplir toutes les valeurs
# ============================================================

# --- Sécurité ---
DJANGO_SECRET=your-50-char-secret-key-here
FERNET_KEY=your-fernet-key-here

# --- Base de données PostgreSQL ---
POSTGRES_USER=laboutik_user
POSTGRES_DB=laboutik
POSTGRES_PASSWORD=your-db-password

# --- Domaine ---
# Ex : mon-evenement.cashless.monassociation.fr
DOMAIN=mon-evenement.cashless.example.fr

# --- Email admin ---
ADMIN_EMAIL=admin@example.fr

# --- Email transactionnel ---
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=contact@example.fr
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# --- Localisation ---
TIME_ZONE=Europe/Paris
LANGUAGE_CODE='fr'
TZ=Europe/Paris

# --- Connexion aux autres services TiBillet ---
FEDOW_URL=https://fedow.example.fr
LESPASS_TENANT_URL=https://example.fr/

# --- Cashless ---
MAIN_ASSET_NAME=MyCoin

# --- Happy Hour ---
HAPPY_HOUR_START=22:00
HAPPY_HOUR_END=23:30
HAPPY_HOUR_PRICE_FILE=/DjangoFiles/www/happy_hour_prices.json

# --- Sauvegarde BorgBackup ---
BORG_REPO=''
BORG_PASSPHRASE=''

# --- Spécifique aux instances additionnelles ---
# Identifiant unique de l'événement/gala (ex : MON_GALA_2026)
GALA_ID=MON_GALA_2026
# Nom du router Traefik — doit être unique par instance (ex : laboutik_mon-evenement)
ROUTER_NAME=laboutik_mon-evenement
# Synchronisation des dons entre caisses : 0=désactivé, 1=activé
ENABLE_GIFT_ASSET_SYNC=0

# --- Version épinglée de l'image Docker ---
LABOUTIK_VERSION=1.3.8
