# ============================================================
# Lespass-v2 — Stack de PREVIEW pour la branche TiBillet V2 (alpha)
# Copier ce fichier en .env et remplir toutes les valeurs.
#
# Ce stack est isolé de la prod (Lespass/) : DB dédiée et vierge,
# pas d'exposition publique (accès via tunnel SSH sur le port 8090).
# Voir .claude/NOTES.md.
# ============================================================

# --- Sécurité ---
# Générer avec : python -c "import secrets; print(secrets.token_hex(25))"
DJANGO_SECRET=your-50-char-secret-key-here
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# --- Base de données PostgreSQL (dédiée, vierge) ---
POSTGRES_USER=lespass_v2_user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=lespass_v2

# --- Email admin ---
ADMIN_EMAIL=admin@example.fr

# --- Localisation ---
TIME_ZONE=Europe/Paris
TZ=Europe/Paris

# --- Domaine (factice, pas de DNS — accès via tunnel SSH uniquement) ---
DOMAIN=v2-preview.localhost
PUBLIC='V2 Preview'
SUB=test
META=agenda
# Permet d'accéder via http://localhost:8090 (tunnel SSH) sans 400 DisallowedHost
ADDITIONAL_DOMAINS=localhost,127.0.0.1

# --- Connexion à Fedow (legacy, optionnel sur V2 — fedow_core est intégré) ---
FEDOW_DOMAIN=fedow.example.fr

# --- Stripe (mode test) ---
STRIPE_TEST=1
STRIPE_KEY_TEST=sk_test_your-stripe-test-key
STRIPE_KEY=

# --- Email transactionnel : désactivé pour la preview (pas de vrais envois) ---
EMAIL_HOST=
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=test@v2-preview.localhost
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0

# --- Celery ---
CELERY_BROKER=redis://redis:6379/0
CELERY_BACKEND=redis://redis:6379/0

# --- API interne (partagé avec Fedow, optionnel sur V2) ---
ACTIVE_GALA_API_TOKEN=your-shared-api-token

# --- Debug / migrations ---
# DEBUG=True pour voir les erreurs (page Django, pas juste 500 nu)
DEBUG=True
# MIGRATE=1 au premier démarrage pour créer le schéma (DB vierge, pas de
# collision avec la prod). À repasser à 0 ensuite si on veut éviter de
# remigrer à chaque redémarrage du conteneur.
MIGRATE=1

# --- Communecter SSO (réactivé sur V2, optionnel — laisser vide) ---
# OAUTH_NAME=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_ACCESS_TOKEN_URL=
# OAUTH_AUTHORIZE_URL=
# OAUTH_BASE_URL=

# --- LaBoutik — tags NFC de démo (optionnel) ---
# DEMO=1
