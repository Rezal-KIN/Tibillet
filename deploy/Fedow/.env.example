# ============================================================
# Fedow — Portefeuille fédéré
# Copier ce fichier en .env et remplir toutes les valeurs
# ============================================================

# --- Sécurité ---
# Générer avec : python -c "import secrets; print(secrets.token_hex(25))"
SECRET_KEY=your-50-char-secret-key-here
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# --- Domaine ---
# Ex : fedow.monassociation.fr
DOMAIN=fedow.example.fr

# --- Base de données PostgreSQL ---
POSTGRES_DB=fedow
POSTGRES_USER=fedow_user
POSTGRES_PASSWORD=your-db-password

# --- Localisation ---
TIME_ZONE=Europe/Paris
TZ=Europe/Paris

# --- Stripe ---
# Mettre STRIPE_TEST=1 pour utiliser les clés de test
STRIPE_TEST=1
STRIPE_KEY_TEST=sk_test_your-stripe-test-key
STRIPE_KEY=sk_live_your-stripe-live-key
STRIPE_KEY_PUBLIC=pk_live_your-stripe-public-key
STRIPE_ENDPOINT_SECRET_TEST=whsec_your-test-webhook-secret
STRIPE_ENDPOINT_SECRET=whsec_your-live-webhook-secret

# --- API interne (partagé avec Lespass et Laboutik) ---
# Token utilisé pour les appels inter-services, doit être identique dans Lespass
ACTIVE_GALA_API_TOKEN=your-shared-api-token

# --- Version épinglée de l'image Docker ---
# Voir les versions disponibles : https://hub.docker.com/r/tibillet/fedow/tags
FEDOW_VERSION=1.3.10
