# Configuration du seul site gala-test sur Estia.
# Le prefixe zz- preserve l'ordre des fichiers actuellement charges et leur defaut.
map $http_upgrade $tibillet_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name gala-test.rezal.fr cashless.gala-test.rezal.fr fedow.gala-test.rezal.fr;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt/tibillet-gala-test;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name gala-test.rezal.fr fedow.gala-test.rezal.fr;

    # Etat Certbot isole : aucune extension du certificat partage du Rezal.
    ssl_certificate /etc/letsencrypt-tibillet-gala-test/live/tibillet-gala-test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt-tibillet-gala-test/live/tibillet-gala-test/privkey.pem;
    ssl_protocols TLSv1.2;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        client_max_body_size 12m;
        proxy_pass http://192.168.1.195:80;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tibillet_connection_upgrade;
        proxy_read_timeout 86400;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Estia est la frontiere de confiance ; ignorer les valeurs du visiteur.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }
}

server {
    listen 443 ssl http2;
    server_name cashless.gala-test.rezal.fr;

    # Etat Certbot isole : aucune extension du certificat partage du Rezal.
    ssl_certificate /etc/letsencrypt-tibillet-gala-test/live/tibillet-gala-test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt-tibillet-gala-test/live/tibillet-gala-test/privkey.pem;
    ssl_protocols TLSv1.2;
    ssl_session_tickets off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location = / {
        return 302 /laboutik/ouvrir/$is_args$args;
    }

    location / {
        client_max_body_size 12m;
        proxy_pass http://192.168.1.195:80;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tibillet_connection_upgrade;
        proxy_read_timeout 86400;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Estia est la frontiere de confiance ; ignorer les valeurs du visiteur.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
    }
}
