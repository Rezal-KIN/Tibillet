# ============================================================
# Lespass — Billetterie & gestion des membres
# Copier ce fichier en .env et remplir toutes les valeurs
# ============================================================

# --- Sécurité ---
# Générer avec : python -c "import secrets; print(secrets.token_hex(25))"
DJANGO_SECRET=your-50-char-secret-key-here
# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your-fernet-key-here

# --- Base de données PostgreSQL ---
POSTGRES_USER=lespass_user
POSTGRES_PASSWORD=your-db-password
POSTGRES_DB=lespass

# --- Email admin ---
ADMIN_EMAIL=admin@example.fr

# --- Localisation ---
TIME_ZONE=Europe/Paris
TZ=Europe/Paris

# --- Domaine ---
# SANS sous-domaine (ex : monassociation.fr, pas lespass.monassociation.fr)
DOMAIN=example.fr
# Nom de l'instance racine (affiché dans l'interface)
PUBLIC='Mon Association'
# Sous-domaine du premier lieu (ex : 'festival' → festival.example.fr)
SUB=monfestival
# Sous-domaine de l'agenda fédéré (ex : 'agenda' → agenda.example.fr)
META=agenda

# --- Connexion à Fedow ---
# Domaine SANS https:// ni slash final
FEDOW_DOMAIN=fedow.example.fr

# --- Stripe ---
STRIPE_TEST=1
STRIPE_KEY_TEST=sk_test_your-stripe-test-key
STRIPE_KEY=sk_live_your-stripe-live-key

# --- Email transactionnel (ex : Brevo/Sendgrid) ---
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
DEFAULT_FROM_EMAIL=contact@example.fr
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

# --- Celery (file de tâches asynchrones) ---
CELERY_BROKER=redis://redis:6379/0
CELERY_BACKEND=redis://redis:6379/0

# --- API interne (partagé avec Fedow) ---
# Doit être identique à ACTIVE_GALA_API_TOKEN dans Fedow/.env
ACTIVE_GALA_API_TOKEN=your-shared-api-token

# --- Optionnel ---
# Domaines additionnels pour le modèle SaaS multi-tenant, séparés par des virgules.
# ADDITIONAL_DOMAINS=domainbis.example.fr
# Code langue par défaut (sinon 'fr' par défaut côté Django)
# LANGUAGE_CODE=fr
# Sentry (monitoring d'erreurs), désactivé si absent
# SENTRY_DNS=

# --- Note sur la version ---
# Depuis le passage à la V2, Lespass n'est plus une image Docker Hub mais est
# construit depuis le code source vendoré en submodule git (./app), épinglé à
# un commit précis. Pour mettre à jour : voir .claude/NOTES.md.
